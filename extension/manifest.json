{
  "manifest_version": 3,
  "name": "DSH Google Chrome Search",
  "version": "0.1.0",
  "description": "Lets a local DSH instance request Google searches through this Chrome profile.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.google.com/*", "https://google.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Google Search",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://www.google.com/sorry/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["parser.js"],
      "matches": ["https://www.google.com/*"]
    }
  ]
}
